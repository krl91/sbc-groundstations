FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf \
    automake \
    bash \
    bc \
    binutils \
    bison \
    build-essential \
    bzip2 \
    ca-certificates \
    cpio \
    curl \
    file \
    flex \
    gawk \
    git \
    gzip \
    libelf-dev \
    libncurses-dev \
    libssl-dev \
    libtool \
    locales \
    make \
    patch \
    perl \
    pkg-config \
    python3 \
    python3-setuptools \
    rsync \
    sed \
    tar \
    unzip \
    wget \
    which \
    xz-utils \
    zstd \
    && sed -i 's/^# *en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen \
    && locale-gen \
    && rm -rf /var/lib/apt/lists/*

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

WORKDIR /work
